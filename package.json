{
  "name": "gray-zone-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Gray-Zone & Critical Infrastructure Risk Monitor — Static Next.js 15 Intelligence Portal & Zero-Key OSINT Collector",
  "scripts": {
    "dev": "next dev",
    "sync:doc": "tsx scripts/sync-doc.ts",
    "sync:drive": "gdrive readonly export 1lDZB7DdprC6tbgMtsT69WEmj-AesGcqvyv3RDE1vSXw content/executive_briefing.md --format md && npm run sync:doc && npm test",
    "ingest:signals": "tsx scripts/ingest-signals.ts",
    "encrypt:bundle": "tsx scripts/encrypt-bundle.ts",
    "rss:generate": "tsx scripts/generate-rss.ts",
    "pwa:generate": "tsx scripts/generate-pwa.ts",
    "prebuild": "tsx scripts/generate-rss.ts && tsx scripts/generate-pwa.ts && tsx scripts/encrypt-bundle.ts",
    "build": "next build",
    "postbuild": "tsx scripts/encrypt-bundle.ts --restore-if-needed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "fast-xml-parser": "^5.2.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
